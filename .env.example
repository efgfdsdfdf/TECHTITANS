# Tech Titans environment placeholders
# Public keys
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
RTC_PROVIDER_URL=https://your-rtc-provider.example.com
RTC_PROVIDER_API_KEY=your-rtc-provider-api-key
RTC_PROVIDER_API_SECRET=your-rtc-provider-api-secret

# Push notification keys
PUSH_PUBLIC_KEY=your-web-push-public-key
PUSH_PRIVATE_KEY=your-web-push-private-key
TECH_TITANS_PUSH_PUBLIC_KEY=your-browser-vapid-public-key

# Feature flags
ENABLE_VOICE_CALLS=true
ENABLE_VIDEO_CALLS=true
ENABLE_GROUP_CALLS=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_ANNOUNCEMENTS=true
